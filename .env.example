# twicetold-npc — environment template. Copy to `.env` at the repo root:
#
#     Copy-Item .env.example .env
#
# `.env` is gitignored and must stay that way. This file carries NO secrets —
# only key names, shapes, and the rules that have actually bitten.
#
# HARD FORMAT RULE: one KEY=VALUE per line, nothing else. No inline comments
# after a value, no multi-line values, no prose wrapped onto a second line.
# A consolidated multi-line price note once crashed `load_settings` on every
# run that read prices (2026-07-21) — that is the reason this rule is shouted.
#
# Verify without printing anything:
#     python -c "from app.config import load_settings; load_settings(); print('ok')"

# ---------------------------------------------------------------------------
# Storage (required, always)
# ---------------------------------------------------------------------------
# Must match docker-compose.yml's POSTGRES_* values — compose reads this same
# file. The database name here is the PRODUCT database; scratch databases are
# created and dropped by the test fixtures, never named here.
POSTGRES_USER=twicetold
POSTGRES_PASSWORD=change-me
POSTGRES_DB=twicetold
# On the compose path the api and migrate containers override DATABASE_URI to
# reach the db service (@db:5432); the value below is what host-side tools use
# (the test suite, the walkers, the CLI, the C# harness). Use 127.0.0.1, NOT
# localhost: the db container publishes IPv4 loopback only (127.0.0.1:5432), and
# on Windows/macOS "localhost" can resolve to IPv6 (::1) first and stall ~20s per
# connection before falling back to IPv4. Keep the password URL-safe (no raw
# @ : / # ? in it), and write a literal $ as $$ so docker compose does not read
# it as interpolation.
DATABASE_URI=postgresql://twicetold:change-me@127.0.0.1:5432/twicetold

# ---------------------------------------------------------------------------
# Provider mode
# ---------------------------------------------------------------------------
# fake = offline, keyless, deterministic (the default for development, the
#        walkers, and the suite). real = live model calls that cost money.
TWICETOLD_PROVIDER_MODE=fake

# ---------------------------------------------------------------------------
# Model roles — ALL SIX required when TWICETOLD_PROVIDER_MODE=real
# ---------------------------------------------------------------------------
# Nothing is hardcoded: every role is an integrator knob. One documented v1
# limit, enforced loudly by `load_settings` rather than guessed around:
#   * IMPORTANCE, RENDER and TYPOLOGY must name the SAME model — one write
#     call serves all three in v1. Divergence raises, never silently picks.
# The same six names name the models on EITHER backend — see the model
# backend block below (the provider-path build, 2026-09-02): on the openai
# backend they are the server's model names (e.g. llama3.1:8b on Ollama).
TWICETOLD_MODEL_IMPORTANCE=claude-haiku-4-5-20251001
TWICETOLD_MODEL_RENDER=claude-haiku-4-5-20251001
TWICETOLD_MODEL_TYPOLOGY=claude-haiku-4-5-20251001
TWICETOLD_MODEL_ESCALATION=claude-haiku-4-5-20251001
# Haiku by ruling (2026-07-29): the B1 A/B put haiku's perceived-first-word at
# p50 951 ms — under the <1 s bar — vs sonnet-5's 1201 ms, at ~4x less dialogue
# cost. Sonnet-5 (and thinking-off variants) get re-assessed once the judged-eval
# harness can score prose.
TWICETOLD_MODEL_DIALOGUE=claude-haiku-4-5-20251001
# Haiku-class by ruling (2026-07-28). It ran as sonnet-5 from 2026-07-21 —
# a stopgap when the var was found missing from .env — which quietly
# contradicted the register for a week. Batched retelling is a Haiku job.
TWICETOLD_MODEL_RECONSTRUCTION=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Eval-runner-only judge role (eval-harness.md stage 3) — NOT one of the six
# ---------------------------------------------------------------------------
# Loaded in both modes, required by NEITHER: the server/REPL never needs a
# judge; the eval runner validates it itself when a --judged run starts.
# Opus-4.8-class by ruling (2026-08-07): dialogue ships haiku and the first
# real compare is haiku vs sonnet-5, so an Opus judge never grades its own
# model's prose.
TWICETOLD_MODEL_JUDGE=claude-opus-4-8
# Bounded max_tokens for judge verdict calls; adaptive thinking spends
# against it. Optional — default 2048.
TWICETOLD_JUDGE_MAX_TOKENS=2048
# Dialogue thinking knob (B2, 2026-08-07). Unset = the thinking parameter is
# OMITTED from the real prose call — today's request byte-for-byte.
# "disabled" sends thinking disabled (the sonnet-5 thinking-off arm). Set
# per-arm via compare overlays (data\eval\arms\), not globally here.
TWICETOLD_DIALOGUE_THINKING=

# ---------------------------------------------------------------------------
# Reflection role (reflection.md, C2 2026-08-15) — NOT one of the six
# ---------------------------------------------------------------------------
# The judge shape exactly: loaded in both modes, required by NEITHER — the
# server starts fine without it; the FIRST real reflect call without it
# raises a loud ConfigError naming this var. Confirmed at Phase D1
# (2026-08-19): Opus 4.8, a stronger model for belief quality (the role is
# idle-time/batch, so latency does not bind; validated to produce coherent,
# evidence-cited beliefs). The worker default stays OFF; enable it per-agent.
TWICETOLD_MODEL_REFLECTION=claude-opus-4-8

# ---------------------------------------------------------------------------
# Compiler role (parameter-compiler.md, C3 2026-08-17) — NOT one of the six
# ---------------------------------------------------------------------------
# The judge shape again (the third such var): loaded in both modes, required
# by NEITHER — the server starts fine without it. C3 has no endpoint, so the
# first real compile is always the worker's: it lands a `failed` run row
# naming this var and logs loud once. Confirmed at Phase D1 (2026-08-19):
# Opus 4.8 (same batch-quality rationale as reflection). The worker default
# stays OFF; enable compiler_worker_enabled per-agent to use the compiler.
TWICETOLD_MODEL_COMPILER=claude-opus-4-8

# ---------------------------------------------------------------------------
# API keys — required in real mode, per backend
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY when TWICETOLD_MODEL_BACKEND=anthropic (the default);
# OPENAI_API_KEY for the hosted embedding path — not required once
# TWICETOLD_EMBEDDING_BASE_URL points at your own server. A key left in
# place for a backend you are not using is ignored, never an error.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Model backend (optional) — the OpenAI-compatible provider path
# ---------------------------------------------------------------------------
# ONE selector for every LLM role (the six above + the three judge-shaped).
# anthropic = the default: the locked slate's path, byte-for-byte.
# openai = the OpenAI-compatible chat-completions family behind a base URL:
# OpenAI itself, Ollama, vLLM, LM Studio, llama.cpp server, OpenRouter,
# LiteLLM, ... The six role vars then name the server's models. The base URL
# is required on openai (http/https — Ollama: http://127.0.0.1:11434/v1;
# OpenAI: https://api.openai.com/v1); the key is optional (local servers
# ignore it, hosted ones need it) and a placeholder is sent when blank.
# Loud at load: a base URL or key under anthropic, a missing base URL under
# openai, TWICETOLD_DIALOGUE_THINKING under openai (an Anthropic knob),
# max_completion_tokens below under anthropic (its wire field is always
# max_tokens).
TWICETOLD_MODEL_BACKEND=anthropic
TWICETOLD_MODEL_BASE_URL=
TWICETOLD_MODEL_API_KEY=
# The token-limit FIELD NAME on the openai backend (the values each role
# sends are unchanged): max_tokens = the default, the field local servers
# document; max_completion_tokens = the field hosted OpenAI's reasoning-class
# models (the gpt-5 family) demand.
TWICETOLD_MODEL_TOKEN_LIMIT_FIELD=max_tokens
# The embedding role's own knobs, independent of the backend above. The
# model NAME is a knob (default: the locked slate's text-embedding-3-small);
# the DIMENSION is locked at 1536 (migration 001). dimensions=1536 is sent on
# every call, so a Matryoshka model (qwen3-embedding on Ollama) emits exactly
# 1536; a narrower model (nomic-embed-text, bge, mxbai) is zero-padded to
# 1536 at the seam — cosine, L2, and inner product are preserved exactly, so
# retrieval math is unchanged — and a wider one is refused loudly. The
# embedding model is a PER-DATABASE choice: switching it orphans every stored
# vector, and there is no re-embed tooling in v1. With a base URL set,
# OPENAI_API_KEY is no longer required; the key below is optional for it.
TWICETOLD_EMBEDDING_MODEL=text-embedding-3-small
TWICETOLD_EMBEDDING_BASE_URL=
TWICETOLD_EMBEDDING_API_KEY=
# THE SMALL-MODEL QUALITY WARNING (ruled with the path, 2026-09-01). Every
# measured number in this repo — cost per 100 turns, perceived-first-word
# p50, the believability no-regression — was taken on the locked Anthropic
# slate and does NOT transfer to another backend. Small local models break
# the structured-output contract first: the write call's JSON (rendered
# telling + importance + typology) and the drift-budgeted batched
# reconstruction. The symptoms are loud and degrade by the ruled ladder,
# never a rejected request: scoring_failed writes at neutral importance,
# failed enrichment runs, retellings falling back to their live heads,
# MalformedOutputError in the log. JSON mode (response_format=json_object)
# is requested on every structured call as the family's mitigation; the
# lenient parser is the second line. Ollama's default context window (4096)
# silently truncates the batched reconstruction prompt from the FRONT: set
# OLLAMA_CONTEXT_LENGTH=16384 or more (or a Modelfile num_ctx). Token
# accounting depends on the server reporting usage — absent usage counts 0
# (warned once) and the cost table reads zero. The judge's calibration and
# its adaptive thinking are Anthropic-only; the judge-shaped roles (judge,
# reflection, compiler) are the most exposed. Hosted OpenAI reasoning-class
# models reject max_tokens: set
# TWICETOLD_MODEL_TOKEN_LIMIT_FIELD=max_completion_tokens for them.

# ---------------------------------------------------------------------------
# Capacity (optional) — process-level ceilings, raise both together
# ---------------------------------------------------------------------------
# Max provider (model) calls in flight at once across the process (the C7
# ModelCallGate; a streaming turn holds one slot for its whole stream), and
# the DB pool's max connections (db.build_pool). The defaults are aligned so
# the cap never starves on a connection; if you raise one, raise the other.
TWICETOLD_MAX_CONCURRENT_MODEL_CALLS=8
TWICETOLD_DB_POOL_MAX_SIZE=8

# ---------------------------------------------------------------------------
# Host guard (optional) — the allowlist for the request Host header
# ---------------------------------------------------------------------------
# The API serves a browser inspector page (The Ledger) and validates the Host
# header of every request against this comma-separated allowlist
# (TrustedHostMiddleware), closing the DNS-rebinding / CSRF class that bites
# localhost-only tools. The default is loopback only; the compose API binds
# 0.0.0.0 inside the container but publishes 127.0.0.1 only. If you front the
# service with a reverse proxy under a hostname, add that hostname here.
TWICETOLD_ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Pricing (optional) — USD per MILLION tokens
# ---------------------------------------------------------------------------
# Instrumentation reports token counts unconditionally. These turn the cost
# table's USD column on; leave them unset and it stays tokens-only. No model
# price is ever hardcoded, so this file is the only place rates live — which
# means a stale rate here silently produces a wrong cost table. Values below
# are placeholders: fill in the rates you are actually billed. On a
# self-hosted backend leave them unset — the table then reads tokens only.
TWICETOLD_PRICE_WRITE_IN=1.00
TWICETOLD_PRICE_WRITE_OUT=5.00
TWICETOLD_PRICE_ESCALATION_IN=1.00
TWICETOLD_PRICE_ESCALATION_OUT=5.00
TWICETOLD_PRICE_DIALOGUE_IN=1.00
TWICETOLD_PRICE_DIALOGUE_OUT=5.00
TWICETOLD_PRICE_RECONSTRUCTION_IN=1.00
TWICETOLD_PRICE_RECONSTRUCTION_OUT=5.00
TWICETOLD_PRICE_EMBEDDING=0.02
# Judge (Opus-4.8-class) list rates at the 2026-08-07 ruling: 5.00 in /
# 25.00 out. Same staleness warning as above.
TWICETOLD_PRICE_JUDGE_IN=5.00
TWICETOLD_PRICE_JUDGE_OUT=25.00
# Reflection (Opus 4.8 by Phase D1 confirmation, 2026-08-19): 5.00 / 25.00.
TWICETOLD_PRICE_REFLECTION_IN=5.00
TWICETOLD_PRICE_REFLECTION_OUT=25.00
# Compiler (Opus 4.8 by Phase D1 confirmation, 2026-08-19): 5.00 / 25.00.
TWICETOLD_PRICE_COMPILER_IN=5.00
TWICETOLD_PRICE_COMPILER_OUT=25.00
