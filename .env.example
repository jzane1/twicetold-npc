# longmem-npc — environment template. Copy to `.env` at the repo root:
#
#     Copy-Item .env.example .env
#
# `.env` is gitignored and must stay that way. This file carries NO secrets —
# only key names, shapes, and the rules that have actually bitten.
#
# HARD FORMAT RULE: one KEY=VALUE per line, nothing else. No inline comments
# after a value, no multi-line values, no prose wrapped onto a second line.
# A consolidated multi-line price note once crashed `load_settings` on every
# run that read prices (2026-07-21) — that is the reason this rule is shouted.
#
# Verify without printing anything:
#     python -c "from app.config import load_settings; load_settings(); print('ok')"

# ---------------------------------------------------------------------------
# Storage (required, always)
# ---------------------------------------------------------------------------
# Must match docker-compose.yml's POSTGRES_* values — compose reads this same
# file. The database name here is the PRODUCT database; scratch databases are
# created and dropped by the test fixtures, never named here.
POSTGRES_USER=longmem
POSTGRES_PASSWORD=change-me
POSTGRES_DB=longmem
DATABASE_URI=postgresql://longmem:change-me@localhost:5432/longmem

# ---------------------------------------------------------------------------
# Provider mode
# ---------------------------------------------------------------------------
# fake = offline, keyless, deterministic (the default for development, the
#        walkers, and the suite). real = live model calls that cost money.
LONGMEM_PROVIDER_MODE=fake

# ---------------------------------------------------------------------------
# Model roles — ALL SIX required when LONGMEM_PROVIDER_MODE=real
# ---------------------------------------------------------------------------
# Nothing is hardcoded: every role is an integrator knob. One documented v1
# limit, enforced loudly by `load_settings` rather than guessed around:
#   * IMPORTANCE, RENDER and TYPOLOGY must name the SAME model — one write
#     call serves all three in v1. Divergence raises, never silently picks.
LONGMEM_MODEL_IMPORTANCE=claude-haiku-4-5-20251001
LONGMEM_MODEL_RENDER=claude-haiku-4-5-20251001
LONGMEM_MODEL_TYPOLOGY=claude-haiku-4-5-20251001
LONGMEM_MODEL_ESCALATION=claude-haiku-4-5-20251001
# Haiku by ruling (2026-07-29): the B1 A/B put haiku's perceived-first-word at
# p50 951 ms — under the <1 s bar — vs sonnet-5's 1201 ms, at ~4x less dialogue
# cost. Sonnet-5 (and thinking-off variants) get re-assessed once the judged-eval
# harness can score prose.
LONGMEM_MODEL_DIALOGUE=claude-haiku-4-5-20251001
# Haiku-class by ruling (2026-07-28). It ran as sonnet-5 from 2026-07-21 —
# a stopgap when the var was found missing from .env — which quietly
# contradicted the register for a week. Batched retelling is a Haiku job.
LONGMEM_MODEL_RECONSTRUCTION=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Eval-runner-only judge role (eval-harness.md stage 3) — NOT one of the six
# ---------------------------------------------------------------------------
# Loaded in both modes, required by NEITHER: the server/REPL never needs a
# judge; the eval runner validates it itself when a --judged run starts.
# Opus-4.8-class by ruling (2026-08-07): dialogue ships haiku and the first
# real compare is haiku vs sonnet-5, so an Opus judge never grades its own
# model's prose.
LONGMEM_MODEL_JUDGE=claude-opus-4-8
# Bounded max_tokens for judge verdict calls; adaptive thinking spends
# against it. Optional — default 2048.
LONGMEM_JUDGE_MAX_TOKENS=2048
# Dialogue thinking knob (B2, 2026-08-07). Unset = the thinking parameter is
# OMITTED from the real prose call — today's request byte-for-byte.
# "disabled" sends thinking disabled (the sonnet-5 thinking-off arm). Set
# per-arm via compare overlays (data\eval\arms\), not globally here.
LONGMEM_DIALOGUE_THINKING=

# ---------------------------------------------------------------------------
# Reflection role (reflection.md, C2 2026-08-15) — NOT one of the six
# ---------------------------------------------------------------------------
# The judge shape exactly: loaded in both modes, required by NEITHER — the
# server starts fine without it; the FIRST real reflect call without it
# raises a loud ConfigError naming this var. Confirmed at Phase D1
# (2026-08-19): Opus 4.8, a stronger model for belief quality (the role is
# idle-time/batch, so latency does not bind; validated to produce coherent,
# evidence-cited beliefs). The worker default stays OFF; enable it per-agent.
LONGMEM_MODEL_REFLECTION=claude-opus-4-8

# ---------------------------------------------------------------------------
# Compiler role (parameter-compiler.md, C3 2026-08-17) — NOT one of the six
# ---------------------------------------------------------------------------
# The judge shape again (the third such var): loaded in both modes, required
# by NEITHER — the server starts fine without it. C3 has no endpoint, so the
# first real compile is always the worker's: it lands a `failed` run row
# naming this var and logs loud once. Confirmed at Phase D1 (2026-08-19):
# Opus 4.8 (same batch-quality rationale as reflection). The worker default
# stays OFF; enable compiler_worker_enabled per-agent to use the compiler.
LONGMEM_MODEL_COMPILER=claude-opus-4-8

# ---------------------------------------------------------------------------
# API keys — required when LONGMEM_PROVIDER_MODE=real
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Capacity (optional) — process-level ceilings, raise both together
# ---------------------------------------------------------------------------
# Max provider (model) calls in flight at once across the process (the C7
# ModelCallGate; a streaming turn holds one slot for its whole stream), and
# the DB pool's max connections (db.build_pool). The defaults are aligned so
# the cap never starves on a connection; if you raise one, raise the other.
LONGMEM_MAX_CONCURRENT_MODEL_CALLS=8
LONGMEM_DB_POOL_MAX_SIZE=8

# ---------------------------------------------------------------------------
# Pricing (optional) — USD per MILLION tokens
# ---------------------------------------------------------------------------
# Instrumentation reports token counts unconditionally. These turn the cost
# table's USD column on; leave them unset and it stays tokens-only. No model
# price is ever hardcoded, so this file is the only place rates live — which
# means a stale rate here silently produces a wrong cost table. Values below
# are placeholders: fill in the rates you are actually billed.
LONGMEM_PRICE_WRITE_IN=1.00
LONGMEM_PRICE_WRITE_OUT=5.00
LONGMEM_PRICE_ESCALATION_IN=1.00
LONGMEM_PRICE_ESCALATION_OUT=5.00
LONGMEM_PRICE_DIALOGUE_IN=1.00
LONGMEM_PRICE_DIALOGUE_OUT=5.00
LONGMEM_PRICE_RECONSTRUCTION_IN=1.00
LONGMEM_PRICE_RECONSTRUCTION_OUT=5.00
LONGMEM_PRICE_EMBEDDING=0.02
# Judge (Opus-4.8-class) list rates at the 2026-08-07 ruling: 5.00 in /
# 25.00 out. Same staleness warning as above.
LONGMEM_PRICE_JUDGE_IN=5.00
LONGMEM_PRICE_JUDGE_OUT=25.00
# Reflection (Opus 4.8 by Phase D1 confirmation, 2026-08-19): 5.00 / 25.00.
LONGMEM_PRICE_REFLECTION_IN=5.00
LONGMEM_PRICE_REFLECTION_OUT=25.00
# Compiler (Opus 4.8 by Phase D1 confirmation, 2026-08-19): 5.00 / 25.00.
LONGMEM_PRICE_COMPILER_IN=5.00
LONGMEM_PRICE_COMPILER_OUT=25.00
