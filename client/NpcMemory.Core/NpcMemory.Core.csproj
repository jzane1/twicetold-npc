<Project Sdk="Microsoft.NET.Sdk">

  <!-- Engine-agnostic core (unity-client.md, ruled 2026-07-27): netstandard2.1
       is the Unity 6 compatibility profile, so this one DLL serves both the
       dotnet console harness and the Unity adapter. Zero UnityEngine
       references by ruling; Newtonsoft everywhere (fork 4) — the same
       serializer Unity ships (com.unity.nuget.newtonsoft-json), one behavior
       in both hosts. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>NpcMemory</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- F2 (2026-09-12): the core source now lives in the embedded UPM package,
         so Unity compiles it directly and there is no committed DLL to refresh.
         This project compiles the SAME files for the dotnet harness. AssemblyName
         defaults to the project name, so the bin output stays NpcMemory.Core.dll.
         The glob matches *.cs only; Unity's minted .meta files never match. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\unity\Packages\com.jacksonzane.twicetold-npc\Runtime\Core\**\*.cs" LinkBase="Core" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
